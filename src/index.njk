---
layout: layouts/base.njk
title: Bear’s Den
---
{% from "art.njk" import bear, walkingBear, projectArt %}
<section class="hero shell" aria-labelledby="welcome-title">
  <div class="hero-copy"><div class="bear-trail" aria-hidden="true">{{ walkingBear() }}{{ walkingBear() }}{{ walkingBear() }}</div><h1 id="welcome-title">Chonky Chonky Little Bear, how he wandering here and there</h1><p class="hero-intro">Hello, this is Bear.</p><a class="button" href="#projects">Explore Rabbit Holes <span aria-hidden="true">↗</span></a></div>
  <div class="hero-scrapbook"><span class="hand-note photo-note">the resident bear <span aria-hidden="true">⤵</span></span><figure class="polaroid"><span class="tape" aria-hidden="true"></span>{% if site.avatar %}<img class="avatar" data-wardrobe-avatar src="{{ site.avatar }}" alt="{{ site.avatarAlt }}" width="1254" height="1254" fetchpriority="high">{% else %}<div class="avatar-placeholder"><span>{{ bear() }}</span><p>A place for the resident bear.</p></div>{% endif %}<figcaption>Bear, in his natural habitat.</figcaption></figure><div class="small-note"><span class="note-pin" aria-hidden="true"></span>currently collecting: <strong>bear feeding winter recipes</strong></div></div>
</section>
<div class="ticker bear-pattern" aria-hidden="true"><div class="shell">{% for step in range(0, 9) %}{{ walkingBear() }}{% endfor %}</div></div>
<section id="projects" class="projects-section shell" aria-labelledby="projects-title"><div class="section-heading"><div><p class="bear-honey-chain" aria-hidden="true">&#x1F43B; &#x1F36F; &#x1F43B; &#x1F36F; &#x1F43B;</p><h2 id="projects-title">Three corners of the den.</h2></div><span class="hand-note">pick a rabbit hole <span aria-hidden="true">↙</span></span></div><div class="project-grid">{% for project in projects %}<article class="project-card"><a href="{{ project.url }}" class="project-card-link"><div class="project-art art-{{ project.art }}">{{ projectArt(project.art) }}<span class="project-number">{{ project.number }}</span></div><div class="project-card-body"><span class="eyebrow">{{ project.label }}</span><h3>{{ project.title }}</h3><p>{{ project.description }}</p><span class="project-open">Open the notebook <span aria-hidden="true">↗</span></span></div></a></article>{% endfor %}</div></section>
<section class="journal-section shell" aria-labelledby="notes-title"><div class="section-heading"><div><p class="bear-honey-chain" aria-hidden="true">&#x1F43B; &#x1F36F; &#x1F43B; &#x1F36F; &#x1F43B;</p><h2 id="notes-title">Mud Pond</h2></div><a class="text-link" href="/journal/">Visit Mud Pond <span aria-hidden="true">↗</span></a></div>{% if collections.journal.length %}{% set entries = collections.journal %}{% include "entry-list.njk" %}{% else %}<div class="journal-empty"><div class="notebook-doodle" aria-hidden="true"><svg viewBox="0 0 100 110" fill="none"><path d="m20 14 58-6 10 86-58 6Z" fill="#e9dfc5" stroke="#6b7055" stroke-width="2"/><path d="m27 13 10 86M38 35l30-3M40 47l30-3M41 59l23-2" stroke="#6b7055" stroke-width="2"/><path d="m68 78 20-35 8 5-20 35-10 8Z" fill="#ad7857" stroke="#6b7055" stroke-width="2"/></svg></div><div><span class="hand-note">a fresh page, for now.</span><h3>Good things take a little wandering.</h3><p>Field notes, half-formed ideas, small discoveries, and the occasional meme.<br> The first entry is still finding its way here.</p></div><span class="paper-label">NO RUSH.<br> JUST CURIOSITY.</span></div>{% endif %}</section>

{% if site.avatar %}<script type="module" src="/assets/js/wardrobe/bootstrap.mjs"></script>{% endif %}
