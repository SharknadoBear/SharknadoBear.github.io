{% from "art.njk" import bear %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or summary or site.description }}">
  <meta name="theme-color" content="#304b3d">
  <title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/Caveat.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/PatrickHand.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header shell">
    <a class="brand" href="/" aria-label="Bear’s Den home"><span class="brand-mark">{{ bear() }}</span><span>Bear’s Den</span></a>
    <nav aria-label="Main navigation">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>The Den</a>
      <a href="/#projects"{% if projectId %} aria-current="location"{% endif %}>Rabbit Holes</a>
      <a href="/journal/"{% if page.url == "/journal/" or kind == "post" or kind == "meme" %} aria-current="{% if page.url == '/journal/' %}page{% else %}location{% endif %}"{% endif %}>Mud Pond</a>
    </nav>
    <span class="header-note">make yourself at home <span aria-hidden="true">↙</span></span>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer shell">
    <div class="footer-main"><div><a class="footer-brand" href="/">Bear’s Den <span aria-hidden="true">✳</span></a><p>Thank you beary, beary much for visiting my site.</p><nav class="profile-links footer-profiles" aria-label="Professional profiles"><a href="{{ site.pnnlUrl }}">Working profile <span aria-hidden="true">↗</span></a><a href="{{ site.linkedinUrl }}">LinkedIn <span aria-hidden="true">↗</span></a></nav></div><a class="wife-link" href="{{ site.wifeUrl }}">Bear wife’s site <span aria-hidden="true">↗</span></a></div>
    <div class="footer-bottom"><a href="#main">Back to the top <span aria-hidden="true">↑</span></a></div>
  </footer>
</body>
</html>
