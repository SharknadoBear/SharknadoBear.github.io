  <style>
    .blossom-postcard{grid-column:1/-1;justify-self:center;width:min(100%,610px);margin:clamp(5px,2vw,26px) 0 0;padding:clamp(7px,1.5vw,13px);background:#fffdf5;border:1px solid #ddd5c3;border-radius:4px 8px 5px 7px;box-shadow:1px 4px 13px #66544516}
    .blossom-postcard svg{display:block;width:100%;height:auto;border-radius:2px}
    .blossom-postcard figcaption{text-align:center;padding:5px 0 2px}
    .blossom-drift use{opacity:0;transform-box:fill-box;transform-origin:center}
    @media(prefers-reduced-motion:no-preference){
      .blossom-postcard.is-drifting .blossom-drift use{animation:postcard-petal-drift 3.7s ease-in-out var(--delay) both}
    }
    @keyframes postcard-petal-drift{
      0%{opacity:0;transform:translate(0,0) rotate(-35deg)}
      18%{opacity:.95}
      72%{opacity:.88}
      100%{opacity:0;transform:translate(var(--sway),var(--drop)) rotate(142deg)}
    }
  </style>
  <script>
    (() => {
      const postcard = document.getElementById('blossom-postcard');
      if (!postcard || !('IntersectionObserver' in window) ||
          !window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        postcard.classList.add('is-drifting');
        observer.disconnect();
      }, { threshold: 0.25 });
      observer.observe(postcard);
    })();
  </script>
