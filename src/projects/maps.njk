<section class="project-story"><p class="eyebrow">THE IDEA</p><h2>A second look<br> at the world.</h2><div class="prose"><p>Maps and graphs have a way of making a complicated world feel a little more understandable—and sometimes a little more surprising.</p><p>This notebook will collect interesting maps and figures I come across during work and personal projects: coastlines, currents, time series, and whatever else catches my eye.</p><p>Each entry will leave room for the figure, its source, a little context, and the question that made it worth keeping.</p></div></section>
<section class="project-story" id="cherry-blossom-atlas">
  <p class="eyebrow">THE CHERRY BLOSSOM ATLAS</p>
  <h2>Where to find cherry blossoms</h2>
  <div class="prose">
    <p>An interactive map of 214 viewing sites across all 50 states and Washington, D.C., with 617 mapped tree records and 294 dated bloom records. Search by place or variety, browse by state, or look back at past bloom dates where records are available.</p>
    <p><a href="/projects/nice-maps-and-wiggling-lines/cherry-blossom-atlas/">Open the full Cherry Blossom Atlas</a></p>
    <p>Pink markers show documented viewing sites, not current blooms. Optional amber markers are research candidates, not viewing recommendations. The atlas links to planting and bloom records from parks, gardens, tree inventories and other sources. Map data credits include <a href="https://github.com/topojson/us-atlas">US Atlas</a> and <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors (ODbL)</a>.</p>
  </div>
  <figure class="blossom-postcard" id="blossom-postcard" data-animation="/assets/images/bear-cherry-blossom-petal-dance.gif">
    <img src="/assets/images/bear-cherry-blossom-petal-dance.png" width="358" height="354" alt="A little brown bear looks up at pink petals drifting from a cherry blossom tree." decoding="async">
    <figcaption class="hand-note">A little spring shower <button type="button" class="blossom-replay" hidden>Play the petal dance</button></figcaption>
  </figure>
  <style>
    .blossom-postcard{grid-column:1/-1;justify-self:center;width:min(100%,384px);margin:clamp(5px,2vw,26px) 0 0;padding:clamp(7px,1.5vw,13px);background:#fffdf5;border:1px solid #ddd5c3;border-radius:4px 8px 5px 7px;box-shadow:1px 4px 13px #66544516}
    .blossom-postcard img[hidden]{display:none}
    .blossom-postcard img{display:block;width:100%;height:auto;border-radius:2px}
    .blossom-postcard figcaption{text-align:center;padding:5px 0 2px}
    .blossom-replay{font:inherit;color:inherit;background:transparent;border:0;text-decoration:underline;cursor:pointer;padding:.25rem .5rem}
  </style>
  <script>
    (() => {
      const card = document.getElementById('blossom-postcard');
      const still = card.querySelector('img');
      const button = card.querySelector('button');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let player, timer;
      let played = false;

      const stop = () => {
        clearTimeout(timer);
        if (player) player.remove();
        player = null;
        still.hidden = false;
        button.textContent = played ? 'Replay the petal dance' : 'Play the petal dance';
      };
      const play = () => {
        if (player) return;
        played = true;
        const frame = still.cloneNode();
        player = frame;
        button.textContent = 'Stop the petal dance';
        frame.addEventListener('load', () => {
          if (player !== frame) return;
          still.hidden = true;
          still.before(frame);
          timer = setTimeout(stop, 2760);
        }, { once: true });
        frame.addEventListener('error', () => { if (player === frame) stop(); }, { once: true });
        frame.src = card.dataset.animation;
      };
      button.hidden = false;
      button.addEventListener('click', () => player ? stop() : play());
      reduceMotion.addEventListener('change', event => { if (event.matches) stop(); });
      if (!reduceMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          if (!entries.some(entry => entry.isIntersecting)) return;
          observer.disconnect();
          if (!played && !reduceMotion.matches) play();
        }, { threshold: 0.35 });
        observer.observe(card);
      }
    })();
  </script>
</section>
